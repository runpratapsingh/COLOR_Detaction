PROJECT_NAME="Chemical Liquid Color Detection System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

DATABASE_URL="sqlite:///./chemical_color.db"

# Quality & Validation Thresholds
BLUR_THRESHOLD=100.0
MAX_UNDEREXPOSED_PERCENTAGE=30.0
MAX_OVEREXPOSED_PERCENTAGE=30.0
MAX_REFLECTION_PERCENTAGE=30.0
MIN_VALID_PIXEL_PERCENTAGE=30.0
MAX_ROI_COLOR_VARIATION_DELTA_E=12.0
MIN_QUALITY_SCORE=55.0

MAX_ACCEPTABLE_DELTA_E=25.0
MIN_CLASS_SEPARATION_DELTA_E=1.5

DEFAULT_WHITE_BALANCE_METHOD="REFERENCE_PATCH"
